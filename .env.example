# ── Required ──
AUTH_SECRET=change-me-generate-with-npm-run-generate-secret
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-strong-password

# ── Optional (recommended for production) ──
# Public site URL — used for sitemap.xml and Open Graph
# SITE_URL=https://yourdomain.com

# Server port (default 4000)
# PORT=4000

# Node environment (set automatically on most hosts)
# NODE_ENV=production
